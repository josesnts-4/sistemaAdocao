<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="260.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.joseramos.sistemaadocao.GUI.view.AdotanteFormController">
    <children>
        <Label layoutX="25.0" layoutY="20.0" text="Cadastrar Novo Adotante">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <GridPane layoutX="25.0" layoutY="70.0" prefHeight="120.0" prefWidth="350.0">
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label text="Nome:" />
                <Label text="CPF:" GridPane.rowIndex="1" />
                <Label text="Endereço:" GridPane.rowIndex="2" />
                <TextField fx:id="txtNome" prefWidth="250.0" GridPane.columnIndex="1" />
                <TextField fx:id="txtCpf" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="1" promptText="111.222.333-44" />
                <TextField fx:id="txtEndereco" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </children>
        </GridPane>
        <HBox alignment="CENTER_RIGHT" layoutX="175.0" layoutY="205.0" prefHeight="40.0" prefWidth="200.0" spacing="15.0">
            <children>
                <Button fx:id="btnSalvar" mnemonicParsing="false" onAction="#handleSalvar" prefWidth="80.0" text="Salvar" />
                <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#handleCancelar" prefWidth="80.0" text="Cancelar" />
            </children>
            <padding>
                <Insets right="10.0" />
            </padding>
        </HBox>
    </children>
</AnchorPane>
